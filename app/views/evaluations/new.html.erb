<div class="page">
  <div class="form-shell">
    <h1>学習を評価する</h1>

    <%= form_with model: @evaluation,
          url: study_record_evaluation_path(@study_record),
          class: "section form-stack",
          style: "margin-top: var(--space-5)" do |form| %>
      <% if @evaluation.errors[:study_record_id].any? %>
        <p class="group-error" role="alert">
          <%= @evaluation.errors.full_messages_for(:study_record_id).first %>
        </p>
      <% end %>

      <fieldset>
        <legend class="field-label">集中</legend>

        <% if @evaluation.errors[:focus_option].any? %>
          <p class="group-error" role="alert">
            <%= @evaluation.errors.full_messages_for(:focus_option).first %>
          </p>
        <% end %>

        <% @focus_options.each do |option| %>
          <div>
            <%= form.radio_button :focus_option_id, option.id %>
            <%= form.label :focus_option_id, value: option.id do %>
              <span><%= option.label %></span>
              <span><%= option.description %></span>
            <% end %>
          </div>
        <% end %>
      </fieldset>

      <fieldset>
        <legend class="field-label">チャレンジ</legend>

        <% if @evaluation.errors[:challenge_option].any? %>
          <p class="group-error" role="alert">
            <%= @evaluation.errors.full_messages_for(:challenge_option).first %>
          </p>
        <% end %>

        <% @challenge_options.each do |option| %>
          <div>
            <%= form.radio_button :challenge_option_id, option.id %>
            <%= form.label :challenge_option_id, value: option.id do %>
              <span><%= option.label %></span>
              <span><%= option.description %></span>
            <% end %>
          </div>
        <% end %>
      </fieldset>

      <%= form.submit "評価する", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
