<div class="evaluation">
  <section class="evaluation-done" aria-label="<%= t(".done") %>">
    <div class="evaluation-done-main">
      <p class="evaluation-done-status">
        <span class="evaluation-done-check" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
        </span>
        <%= t(".done") %>
      </p>
      <p class="evaluation-done-minutes">
        <span class="num"><%= @study_record.actual_minutes %></span><span class="evaluation-done-unit">分</span>
      </p>
    </div>

    <dl class="evaluation-done-facts">
      <div class="evaluation-done-row">
        <dt class="evaluation-done-key">
          <span class="evaluation-done-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 20l1-4L16.5 4.5a2 2 0 0 1 3 3L8 19z"/><path d="M14.5 6.5l3 3"/></svg>
          </span>
          <%= StudyRecord.human_attribute_name(:activity) %>
        </dt>
        <dd class="evaluation-done-value"><%= @study_record.activity %></dd>
      </div>
      <div class="evaluation-done-row">
        <dt class="evaluation-done-key">
          <span class="evaluation-done-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="13.5" r="6.5"/><path d="M12 13.5V9.5M12 7V4M9.5 4h5"/></svg>
          </span>
          <%= t(".planned_minutes") %>
        </dt>
        <dd class="evaluation-done-value num"><%= @study_record.planned_minutes %>分</dd>
      </div>
      <% if @study_record.learning_skill %>
        <div class="evaluation-done-row">
          <dt class="evaluation-done-key">
            <span class="evaluation-done-icon" aria-hidden="true">
              <%= render "shared/bulb_icon", css_class: "evaluation-done-bulb" %>
            </span>
            <%= t(".learning_skill") %>
          </dt>
          <dd class="evaluation-done-value"><%= @study_record.learning_skill.name %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <div class="evaluation-question">
    <h1 class="evaluation-question-title"><%= t(".question") %></h1>
    <p class="evaluation-question-help"><%= t(".question_help") %></p>
  </div>

  <%= form_with model: @evaluation, url: study_record_evaluation_path(@study_record), class: "evaluation-form" do |form| %>
    <% if @evaluation.errors[:base].any? %>
      <p class="group-error" role="alert">
        <%= @evaluation.errors.full_messages_for(:base).first %>
      </p>
    <% end %>

    <%= tag.fieldset class: "evaluation-panel", aria: { describedby: ("focus-option-error" if @evaluation.errors[:focus_option].any?) } do %>
      <legend class="evaluation-panel-head">
        <span class="evaluation-panel-label">
          <span class="evaluation-panel-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r=".6"/></svg>
          </span>
          <%= Evaluation.human_attribute_name(:focus_option) %>
        </span>
        <span class="evaluation-panel-aux"><%= t(".choose_one", count: @focus_options.size) %></span>
      </legend>

      <% if @evaluation.errors[:focus_option].any? %>
        <p class="group-error evaluation-panel-error" id="focus-option-error" role="alert">
          <%= @evaluation.errors.full_messages_for(:focus_option).first %>
        </p>
      <% end %>

      <div class="evaluation-choices<%= ' has-error' if @evaluation.errors[:focus_option].any? %>">
        <% @focus_options.each do |option| %>
          <%= form.radio_button :focus_option_id, option.id, class: "evaluation-choice-input" %>
          <%= form.label :focus_option_id, value: option.id, class: "evaluation-choice" do %>
            <span class="evaluation-choice-label"><%= option.label %></span>
            <span class="evaluation-choice-description"><%= option.description %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= tag.fieldset class: "evaluation-panel", aria: { describedby: ("challenge-option-error" if @evaluation.errors[:challenge_option].any?) } do %>
      <legend class="evaluation-panel-head">
        <span class="evaluation-panel-label">
          <span class="evaluation-panel-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 21 10.5 3"/><path d="M10.5 4c3.3.3 5.5 3 8.5 3.5l-2.7 8.3c-3-.3-5.2-3-8.5-3.5z"/></svg>
          </span>
          <%= Evaluation.human_attribute_name(:challenge_option) %>
        </span>
        <span class="evaluation-panel-aux"><%= t(".choose_one", count: @challenge_options.size) %></span>
      </legend>

      <% if @evaluation.errors[:challenge_option].any? %>
        <p class="group-error evaluation-panel-error" id="challenge-option-error" role="alert">
          <%= @evaluation.errors.full_messages_for(:challenge_option).first %>
        </p>
      <% end %>

      <div class="evaluation-choices<%= ' has-error' if @evaluation.errors[:challenge_option].any? %>">
        <% @challenge_options.each do |option| %>
          <%= form.radio_button :challenge_option_id, option.id, class: "evaluation-choice-input" %>
          <%= form.label :challenge_option_id, value: option.id, class: "evaluation-choice" do %>
            <span class="evaluation-choice-label"><%= option.label %></span>
            <span class="evaluation-choice-description"><%= option.description %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="evaluation-actions">
      <%= form.submit t(".submit"), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
