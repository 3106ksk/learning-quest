<div class="page">
  <div class="form-shell">
    <header>
      <h1>タイマー完了</h1>
      <p style="margin-top: var(--space-2)">
        <span class="num"><%= @study_record.planned_minutes %></span>分 / <%= @study_record.activity %>
      </p>
    </header>

    <section class="section" style="margin-top: var(--space-5)">
      <h2>今回の学習を振り返ってください</h2>
      <p class="small" style="margin-top: var(--space-2)">実感に近いものを1つずつ選んでください。</p>
      <p class="caption" style="margin-top: var(--space-2)">この振り返りは、ふみが読む記録になります。</p>

      <section style="margin-top: var(--space-6)">
        <h3>着手</h3>
        <p style="margin-top: var(--space-2)">
          学習を開始したことは自動で記録されています。 <span class="caption">自動記録</span>
        </p>
      </section>

      <%= form_with model: @evaluation, url: study_record_evaluation_path(@study_record), style: "margin-top: var(--space-6)" do |form| %>
        <%# #140以降、評価保存とevaluatedへの遷移が同一トランザクションのため通常は到達しない。
            レースコンディション時のrescue経路(RecordNotUnique)はリダイレクトするのでここも通らないが、
            将来status遷移の仕様が変わった場合の保険として残す。 %>
        <% if @evaluation.errors[:study_record_id].any? %>
          <p class="group-error" role="alert">
            <%= @evaluation.errors.full_messages_for(:study_record_id).first %>
          </p>
        <% end %>

        <div class="eval-columns">
          <fieldset<%= ' aria-describedby="focus-option-error"'.html_safe if @evaluation.errors[:focus_option].any? %>>
            <legend><h3>集中</h3></legend>

            <% if @evaluation.errors[:focus_option].any? %>
              <p class="group-error" id="focus-option-error" role="alert">
                <%= @evaluation.errors.full_messages_for(:focus_option).first %>
              </p>
            <% end %>

            <div class="choice-list<%= ' has-error' if @evaluation.errors[:focus_option].any? %>">
              <% @focus_options.each do |option| %>
                <%= form.radio_button :focus_option_id, option.id, class: "choice-input" %>
                <%= form.label :focus_option_id, value: option.id, class: "choice-row" do %>
                  <span class="choice-mark" aria-hidden="true"></span>
                  <span>
                    <strong><%= option.label %></strong><br>
                    <span class="small"><%= option.description %></span>
                  </span>
                <% end %>
              <% end %>
            </div>
          </fieldset>

          <fieldset<%= ' aria-describedby="challenge-option-error"'.html_safe if @evaluation.errors[:challenge_option].any? %>>
            <legend><h3>チャレンジ</h3></legend>

            <% if @evaluation.errors[:challenge_option].any? %>
              <p class="group-error" id="challenge-option-error" role="alert">
                <%= @evaluation.errors.full_messages_for(:challenge_option).first %>
              </p>
            <% end %>

            <div class="choice-list<%= ' has-error' if @evaluation.errors[:challenge_option].any? %>">
              <% @challenge_options.each do |option| %>
                <%= form.radio_button :challenge_option_id, option.id, class: "choice-input" %>
                <%= form.label :challenge_option_id, value: option.id, class: "choice-row" do %>
                  <span class="choice-mark" aria-hidden="true"></span>
                  <span>
                    <strong><%= option.label %></strong><br>
                    <span class="small"><%= option.description %></span>
                  </span>
                <% end %>
              <% end %>
            </div>
          </fieldset>
        </div>

        <div class="button-row evaluation-actions" style="margin-top: var(--space-7)">
          <%= form.submit "評価する", class: "btn btn-primary" %>
        </div>
      <% end %>
    </section>
  </div>
</div>
