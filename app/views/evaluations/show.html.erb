<% content_for :title, @study_record.activity %>

<div class="page">
  <div class="form-shell">
    <header>
      <h1><%= @study_record.activity %></h1>

      <p class="small">
        <time datetime="<%= @study_record.started_at.iso8601 %>">
          <%= l(@study_record.started_at, format: :evaluation_result) %>
        </time>
        <span aria-hidden="true">／</span>
        <%= t(
              ".meta",
              planned: @study_record.planned_minutes,
              actual: @study_record.actual_minutes
            ) %>
      </p>
    </header>

    <div
      class="stamp stamp-<%= @study_record.rank %> stamp-lg stamp-stage"
      role="img"
      aria-label="<%= t("rank.aria_label", rank: @study_record.rank.upcase) %>"
    >
      <svg viewBox="0 0 96 96" fill="currentColor" aria-hidden="true" focusable="false">
        <circle cx="48" cy="48" r="45" fill="none" stroke="currentColor" stroke-width="1.5" />
        <circle cx="48" cy="48" r="42" fill="none" stroke="currentColor" stroke-width="0.75" />
        <text x="48" y="55" font-size="43" font-weight="600" text-anchor="middle"><%= @study_record.rank.upcase %></text>
        <text x="48" y="71" font-size="7" letter-spacing="1.4" text-anchor="middle"><%= t("rank.label") %></text>
      </svg>
    </div>

    <section aria-labelledby="effort-title">
      <h2 id="effort-title" class="section-title"><%= t(".breakdown_title") %></h2>

      <dl class="effort-list">
        <div class="effort-row">
          <dt class="effort-label"><%= t("evaluation_result.axis_start") %></dt>
          <dd><%= t("evaluation_result.start_label") %></dd>
        </div>

        <div class="effort-row">
          <dt class="effort-label"><%= t("evaluation_result.axis_focus") %></dt>
          <dd>
            <strong><%= @evaluation.focus_option.label %></strong>
            <% if @evaluation.focus_option.description.present? %>
              <span class="small"><%= @evaluation.focus_option.description %></span>
            <% end %>
          </dd>
        </div>

        <div class="effort-row">
          <dt class="effort-label"><%= t("evaluation_result.axis_challenge") %></dt>
          <dd>
            <strong><%= @evaluation.challenge_option.label %></strong>
            <% if @evaluation.challenge_option.description.present? %>
              <span class="small"><%= @evaluation.challenge_option.description %></span>
            <% end %>
          </dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="rank-reason-title">
      <h2 id="rank-reason-title" class="sr-only"><%= t(".reason_title") %></h2>
      <p><%= t("rank.#{@study_record.rank}.reason") %></p>
    </section>

    <div class="button-row">
      <%= link_to t(".to_history"), home_path, class: "btn btn-primary" %>
      <%= link_to t(".to_study"), new_study_record_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
