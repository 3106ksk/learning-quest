<% content_for :title, @study_record.activity %>

<div class="page evaluation-result-page">
  <div class="form-shell">
    <header class="evaluation-result-header">
      <h1><%= @study_record.activity %></h1>
    </header>

    <div class="stamp-stage">
      <%= render "shared/rank_stamp", rank: @study_record.rank, size_class: "stamp-l" %>
    </div>

    <section class="evaluation-result-section evaluation-session" aria-labelledby="session-title">
      <h2 id="session-title" class="evaluation-result-section-title"><%= t(".session.title") %></h2>

      <dl class="definition-list evaluation-result-list evaluation-session-list">
        <div class="definition-row">
          <dt><%= t(".session.started_at") %></dt>
          <dd>
            <time datetime="<%= @study_record.started_at.iso8601 %>">
              <%= l(@study_record.started_at, format: :evaluation_result) %>
            </time>
          </dd>
        </div>

        <div class="definition-row">
          <dt><%= t(".session.planned_minutes") %></dt>
          <dd class="num"><%= @study_record.planned_minutes %>分</dd>
        </div>

        <div class="definition-row">
          <dt><%= t(".session.actual_minutes") %></dt>
          <dd class="num"><%= @study_record.actual_minutes %>分</dd>
        </div>
      </dl>
    </section>

    <section class="evaluation-result-section" aria-labelledby="effort-title">
      <h2 id="effort-title" class="evaluation-result-section-title"><%= t(".breakdown_title") %></h2>

      <dl class="definition-list evaluation-result-list evaluation-breakdown">
        <div class="definition-row">
          <dt><%= t("evaluation_result.axes.start") %></dt>
          <dd><%= t("evaluation_result.start_label") %></dd>
        </div>

        <div class="definition-row">
          <dt><%= t("evaluation_result.axes.focus") %></dt>
          <dd>
            <p><strong><%= @evaluation.focus_option.label %></strong></p>
            <% if @evaluation.focus_option.description.present? %>
              <p class="small"><%= @evaluation.focus_option.description %></p>
            <% end %>
          </dd>
        </div>

        <div class="definition-row">
          <dt><%= t("evaluation_result.axes.challenge") %></dt>
          <dd>
            <p><strong><%= @evaluation.challenge_option.label %></strong></p>
            <% if @evaluation.challenge_option.description.present? %>
              <p class="small"><%= @evaluation.challenge_option.description %></p>
            <% end %>
          </dd>
        </div>
      </dl>

      <p class="small evaluation-result-reason"><%= t("rank.reasons.#{@study_record.rank}") %></p>
    </section>

    <div class="button-row evaluation-result-actions">
      <%= link_to t(".actions.history"), histories_path, class: "btn btn-primary" %>
      <%= link_to t(".actions.study_again"), new_study_record_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
