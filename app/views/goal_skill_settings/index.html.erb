<% content_for :title, t(".title", goal_name: @goal.name) %>

<div class="page-wide goal-skill-settings-page">
  <header class="goal-skill-settings-header">
    <%= link_to t(".back"), goal_hub_path, class: "goal-skill-settings-back" %>
    <h1 class="goal-skill-settings-title"><%= t(".title", goal_name: @goal.name) %></h1>
  </header>

  <section class="goal-skill-settings-selected" aria-labelledby="selected-skills-heading">
    <h2 id="selected-skills-heading" class="goal-skill-settings-selected-title"><%= t(".selected_skills") %></h2>

    <div class="dex-tiles goal-skill-settings-selected-tiles">
      <% @skill_settings.each do |skill_setting| %>
        <% learning_skill = skill_setting.learning_skill %>
        <div class="dex-tile skill-tile">
          <div class="dex-tile-face face-in-use">
            <svg class="dex-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.7.6 1 1.3 1 2.1h5c0-.8.3-1.5 1-2.1A6 6 0 0 0 12 3z" />
            </svg>
            <p class="dex-tile-title"><%= learning_skill.name %></p>
            <%= button_to goal_skill_setting_path(@goal, skill_setting), method: :delete,
                  aria: { label: "#{learning_skill.name}をこの目標で使うのをやめる" },
                  class: "skill-in-use-mark skill-unset-button" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.7.6 1 1.3 1 2.1h5c0-.8.3-1.5 1-2.1A6 6 0 0 0 12 3z" />
              </svg>
            <% end %>
          </div>
          <div class="dex-tile-body"></div>
        </div>
      <% end %>

      <% [4 - @skill_settings.size, 0].max.times do %>
        <div class="dex-empty-tile" aria-hidden="true">
          <span class="dex-empty-face"></span>
          <span class="dex-empty-label"></span>
        </div>
      <% end %>
    </div>
  </section>

  <section class="dex-list goal-skill-settings-list" aria-labelledby="goal-skill-settings-heading">
    <div class="dex-list-header">
      <h2 id="goal-skill-settings-heading" class="panel-eyebrow"><%= t(".eyebrow") %></h2>
      <% if @learning_skills.empty? %>
        <%= link_to t(".new_skill"), learning_skills_path, class: "btn btn-secondary" %>
      <% end %>
    </div>

    <%= render "learning_skills/tiles", learning_skills: @learning_skills, goal: @goal %>
  </section>
</div>
