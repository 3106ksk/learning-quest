<% content_for :title, t(".title") %>

<div class="page-wide">
  <%= turbo_frame_tag @goal do %>
    <section class="goal-form-card goal-form-card--edit" aria-label="<%= t(".title") %>">
      <%= form_with model: @goal, class: "goal-form" do |form| %>
        <%= render "name_field", form: form, goal: @goal, show_error: true %>

        <div class="goal-form-actions is-split">
          <%= link_to t(".cancel"), goal_path(@goal), class: "btn btn-ghost" %>
          <%= form.submit t(".submit"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
