<% content_for :title, t(".title") %>

<div class="page-wide">
  <section class="panel" aria-labelledby="goals-title">
    <p class="panel-eyebrow"><%= t(".eyebrow") %></p>

    <% if @goals.any? %>
      <div class="card-grid">
        <% @goals.each do |goal| %>
          <%= link_to goal_path(goal), class: "grid-card" do %>
            <div class="grid-card-face face-<%= goal.status %>">
              <svg class="goal-card-watermark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6 4.5h9l3 3V19.5h-12z" />
              </svg>
              <span class="card-badge badge-<%= goal.status %>">
                <%= t("enums.goal.status.#{goal.status}") %>
              </span>
            </div>
            <div class="grid-card-body">
              <p class="grid-card-title"><%= goal.name %></p>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p><%= t(".empty") %></p>
        <%= link_to t(".new_goal"), new_goal_path %>
      </div>
    <% end %>
  </section>
</div>
