<% content_for :title, @goal.name %>

<div class="page">
  <%= turbo_frame_tag @goal do %>
    <% if turbo_frame_request? && flash[:danger].present? %>
      <div class="error-banner" style="margin-bottom: var(--space-4)"><%= flash[:danger] %></div>
    <% end %>

    <section class="goal-card" aria-labelledby="goal-title">
      <div class="goal-card-overview">
        <div class="goal-card-heading">
          <span class="card-badge badge-<%= @goal.status %>">
            <%= t("enums.goal.status.#{@goal.status}") %>
          </span>
          <h1 id="goal-title" class="goal-card-title"><%= @goal.name %></h1>
        </div>
        <div class="goal-card-actions">
          <% if @goal.active? %>
            <%= link_to t(".edit"), edit_goal_path(@goal), class: "btn btn-secondary" %>
            <%= button_to t(".complete"), complete_goal_path(@goal), method: :patch,
                  data: { turbo_confirm: t(".confirm", name: @goal.name) },
                  class: "btn btn-secondary" %>
          <% else %>
            <%= link_to t(".new_goal"), new_goal_path, data: { turbo_frame: "_top" } %>
          <% end %>
          <% study_records_count = @goal.study_records.count %>
          <% destroy_confirm = study_records_count.positive? ?
               t(".destroy_confirm", name: @goal.name, count: study_records_count) :
               t(".destroy_confirm_without_records", name: @goal.name) %>
          <%= button_to t(".destroy"), goal_path(@goal), method: :delete,
                data: { turbo_confirm: destroy_confirm, turbo_frame: "_top" },
                class: "btn btn-destructive" %>
        </div>
      </div>
      <% if @goal.completed? %>
        <p class="caption" style="margin-top: var(--space-3)">
          <%= l(@goal.completed_at.to_date, format: :completed) %>
        </p>
      <% end %>
    </section>
  <% end %>
</div>
