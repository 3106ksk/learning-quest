<% content_for :title, "学習スキル" %>

<div class="page-wide goal-dex-page">
  <div class="goal-dex is-skill">
    <%= turbo_frame_tag "skill-form" do %>
      <%= link_to new_learning_skill_path, class: "goal-dex-hero skill-dex-add" do %>
        <div class="goal-dex-hero-face face-non skill-dex-add-face" aria-hidden="true">＋</div>
        <div class="goal-dex-hero-body">
          <p class="goal-dex-hero-name">新しい学習スキル</p>
        </div>
      <% end %>
    <% end %>

    <section class="goal-dex-list" aria-labelledby="learning-skills-heading">
      <div class="goal-dex-list-header">
        <h2 id="learning-skills-heading" class="panel-eyebrow">登録済み</h2>
      </div>

      <div class="goal-dex-tiles">
        <% @learning_skills.each do |learning_skill| %>
          <div class="goal-dex-tile">
            <div class="goal-dex-tile-face face-non">
              <svg class="goal-card-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.7.6 1 1.3 1 2.1h5c0-.8.3-1.5 1-2.1A6 6 0 0 0 12 3z" />
              </svg>
            </div>
            <div class="goal-dex-tile-body">
              <p class="goal-dex-tile-title"><%= learning_skill.name %></p>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</div>
