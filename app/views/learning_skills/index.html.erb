<% content_for :title, t(".title") %>

<div class="page-wide dex-page">
  <div class="dex is-skill">
    <%= turbo_frame_tag "skill-form" do %>
      <% if @learning_skill&.errors&.any? %>
        <%= render "learning_skills/form", learning_skill: @learning_skill %>
      <% else %>
        <%= link_to new_learning_skill_path, class: "skill-add-card" do %>
          <%= render "shared/skill_illustration" %>
          <span class="skill-add-title"><%= t(".new_skill") %></span>
          <span class="skill-add-description"><%= t(".new_skill_description") %></span>
          <span class="skill-add-button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            <%= t(".add") %>
          </span>
        <% end %>
      <% end %>
    <% end %>

    <section class="dex-list skill-list" aria-labelledby="learning-skills-heading">
      <div class="skill-list-header">
        <h2 id="learning-skills-heading" class="skill-list-heading">
          <span class="skill-list-heading-icon" aria-hidden="true"><%= render "shared/bulb_icon", css_class: nil %></span>
          <%= t(".eyebrow") %>
        </h2>
        <p class="skill-list-count"><%= t(".count", count: @learning_skills.size) %></p>
      </div>

      <%= render "learning_skills/tiles", learning_skills: @learning_skills %>
    </section>
  </div>
</div>
