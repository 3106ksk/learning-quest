<%# 登録・ログインの項目のラベルに添える線画のアイコン。name: person / mail / lock / lock_check %>
<svg class="auth-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <% case name %>
  <% when "person" %>
    <circle cx="12" cy="8" r="3.5" />
    <path d="M5 20c0-3.9 3.1-6 7-6s7 2.1 7 6" />
  <% when "mail" %>
    <rect x="3.5" y="6" width="17" height="12" rx="2" />
    <path d="M4 7.5l8 6 8-6" />
  <% when "lock" %>
    <rect x="5.5" y="11" width="13" height="9" rx="2" />
    <path d="M8.5 11V8a3.5 3.5 0 0 1 7 0v3" />
  <% when "lock_check" %>
    <rect x="5.5" y="11" width="13" height="9" rx="2" />
    <path d="M8.5 11V8a3.5 3.5 0 0 1 7 0v3" />
    <path d="M9.7 15.5l1.7 1.7 3-3.4" />
  <% end %>
</svg>
