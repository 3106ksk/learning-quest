<header class="header">
  <% if user_signed_in? %>
    <%= link_to t(".brand"), new_study_record_path, class: "header-brand" %>

    <nav aria-label="メインメニュー">
      <ul class="header-list">
        <li>
          <%= link_to new_study_record_path, class: "header-link", aria: { current: nav_current("study_records") } do %>
            <svg class="header-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13.5" r="6.5"/><path d="M12 13.5V9.5M12 7V4M9.5 4h5"/></svg>
            <%= t(".nav_study") %>
          <% end %>
        </li>
        <li>
          <%= link_to goal_hub_path, class: "header-link", aria: { current: nav_current("goal_hubs", "goals", "goal_skill_settings", "weekly_reflections", "reviews") } do %>
            <svg class="header-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21 10.5 3"/><path d="M10.5 4c3.3.3 5.5 3 8.5 3.5l-2.7 8.3c-3-.3-5.2-3-8.5-3.5z"/></svg>
            <%= t(".nav_goals") %>
          <% end %>
        </li>
        <li>
          <%= link_to learning_skills_path, class: "header-link", aria: { current: nav_current("learning_skills") } do %>
            <svg class="header-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.7.6 1 1.3 1 2.1h5c0-.8.3-1.5 1-2.1A6 6 0 0 0 12 3z"/></svg>
            <%= t(".nav_learning_skills") %>
          <% end %>
        </li>
      </ul>
    </nav>

    <div class="header-account-area">
      <span class="header-account"><%= current_user.account_name %></span>
      <%= button_to t(".logout"), destroy_user_session_path, method: :delete, class: "header-logout" %>
    </div>
  <% else %>
    <%= link_to t(".brand"), root_path, class: "header-brand" %>

    <nav aria-label="アカウント">
      <ul class="header-list">
        <li><%= link_to t(".login"), new_user_session_path, class: "header-login" %></li>
        <li><%= link_to t(".sign_up"), new_user_registration_path, class: "btn btn-secondary" %></li>
      </ul>
    </nav>
  <% end %>
</header>
