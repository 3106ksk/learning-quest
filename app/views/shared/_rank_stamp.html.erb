<%# locals: (rank:, size_class: nil) %>
<% rank_code = rank.to_s %>

<span
  class="<%= class_names("stamp", "stamp-#{rank_code}", size_class) %>"
  role="img"
  aria-label="<%= t("rank.stamp.aria_label", rank: rank_code.upcase) %>"
>
  <svg viewBox="0 0 96 96" fill="currentColor" aria-hidden="true" focusable="false">
    <circle cx="48" cy="48" r="45" fill="none" stroke="currentColor" stroke-width="1.5" />
    <circle cx="48" cy="48" r="42" fill="none" stroke="currentColor" stroke-width="0.75" />
    <text x="48" y="55" font-size="43" font-weight="600" text-anchor="middle"><%= rank_code.upcase %></text>
    <text class="stamp-rank-word" x="48" y="71" font-size="7" letter-spacing="1.4" text-anchor="middle"><%= t("rank.stamp.label") %></text>
  </svg>
</span>
