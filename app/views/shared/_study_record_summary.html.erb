<%# locals: (study_record:) %>

<section class="evaluation-result-section evaluation-session" aria-labelledby="session-title">
  <h2 id="session-title" class="evaluation-result-section-title"><%= t(".title") %></h2>

  <dl class="definition-list evaluation-result-list evaluation-session-list">
    <div class="definition-row">
      <dt><%= t(".started_at") %></dt>
      <dd>
        <time datetime="<%= study_record.started_at.iso8601 %>">
          <%= l(study_record.started_at, format: :record) %>
        </time>
      </dd>
    </div>

    <div class="definition-row">
      <dt><%= t(".planned_minutes") %></dt>
      <dd class="num"><%= t(".duration_minutes", minutes: study_record.planned_minutes) %></dd>
    </div>

    <div class="definition-row">
      <dt><%= t(".actual_minutes") %></dt>
      <dd class="num"><%= t(".duration_minutes", minutes: study_record.actual_minutes) %></dd>
    </div>
  </dl>
</section>
