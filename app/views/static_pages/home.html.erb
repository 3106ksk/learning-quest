<% content_for(:title, "#{t('.brand')} — #{t('.headline')}") %>

<section class="lp-hero" aria-labelledby="hero-title">
  <div class="lp-hero-inner">
    <p class="brand"><%= t('.brand') %></p>

    <h1 id="hero-title" style="margin-top: var(--space-4)"><%= t('.headline') %></h1>

    <p class="caption" style="margin-top: var(--space-3)">
      <%= t('.caption') %>
    </p>

    <p class="small" style="margin-top: var(--space-5); white-space: pre-line"><%= t('.body') %></p>

    <div class="lp-cta-row">
      <%= link_to t('.cta_primary'), sign_up_path, class: "btn btn-primary" %>
      <%= link_to t('.cta_login'), new_session_path %>
    </div>
  </div>
</section>
