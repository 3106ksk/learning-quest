<section class="lp-hero" aria-labelledby="hero-title">
  <div class="lp-hero-inner">
    <p class="lp-brand"><%= t('.brand') %></p>

    <h1 id="hero-title" class="lp-headline"><%= t('.headline') %></h1>

    <p class="lp-lead"><%= t('.lead') %></p>

    <div class="lp-cta-row">
      <%= link_to t('.cta_primary'), new_user_registration_path,
            class: "btn btn-primary", aria: { describedby: "lp-hero-cta-note" } %>
      <%= link_to t('.cta_login'), new_user_session_path, class: "btn lp-btn-secondary" %>
    </div>

    <p id="lp-hero-cta-note" class="lp-cta-note"><%= t('.cta_note') %></p>

    <p class="lp-consent">
      <%= t('.consent_html',
            terms: link_to(t('shared.footer.terms'), terms_path),
            privacy: link_to(t('shared.footer.privacy'), privacy_path)) %>
    </p>
  </div>
</section>

<section class="lp-section" aria-labelledby="problems-title">
  <h2 id="problems-title" class="lp-section-title"><%= t('.problems.title') %></h2>

  <div class="lp-two">
    <% %i[learner service].each do |group| %>
      <div class="lp-panel lp-panel-<%= group %>">
        <span class="lp-label"><%= t(".problems.#{group}.label") %></span>
        <% t(".problems.#{group}.items").each_with_index do |item, index| %>
          <div class="lp-item">
            <svg class="lp-flow-icon lp-item-icon" viewBox="0 0 120 120" aria-hidden="true"><use href="#lp-pc<%= (group == :learner ? 0 : 3) + index + 1 %>"/></svg>
            <div>
              <h3 class="lp-card-title"><%= item[:title] %></h3>
              <p class="lp-card-body"><%= item[:body] %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<section class="lp-section" aria-labelledby="steps-title">
  <h2 id="steps-title" class="lp-section-title"><%= t('.steps.title') %></h2>

  <ol class="lp-flow">
    <% t('.steps.items').each_with_index do |item, index| %>
      <li class="lp-flow-row">
        <div class="lp-flow-card">
          <svg class="lp-flow-icon" viewBox="0 0 120 120" aria-hidden="true"><use href="#lp-ic<%= index + 1 %>"/></svg>
          <h3 class="lp-card-title"><%= item[:title] %></h3>
          <p class="lp-card-body"><%= item[:body] %></p>
        </div>
        <span class="lp-flow-node num" aria-hidden="true"><%= index + 1 %></span>
      </li>
    <% end %>
  </ol>
</section>

<section class="lp-section" aria-labelledby="trend-title">
  <h2 id="trend-title" class="lp-section-title"><%= t('.trend.title') %></h2>
  <p class="lp-feature-body"><%= t('.trend.body') %></p>

  <ul class="lp-card-grid lp-trend-grid">
    <% t('.trend.items').each do |item| %>
      <li class="lp-card">
        <span class="lp-label"><%= item[:label] %></span>
        <p class="lp-trend-phrase"><%= item[:phrase] %></p>
        <dl class="lp-trend-bars">
          <div class="lp-trend-bar">
            <dt><%= t('.trend.previous') %> <%= item[:previous] %></dt>
            <dd><span style="width: <%= item[:previous_width] %>%"></span></dd>
          </div>
          <div class="lp-trend-bar lp-trend-bar-current">
            <dt><%= t('.trend.current') %> <%= item[:current] %></dt>
            <dd><span style="width: <%= item[:current_width] %>%"></span></dd>
          </div>
        </dl>
      </li>
    <% end %>
  </ul>
</section>

<section class="lp-section lp-closing" aria-labelledby="closing-title">
  <h2 id="closing-title" class="lp-closing-title"><%= t('.closing.title') %></h2>

  <div class="lp-cta-row lp-cta-row-center">
    <%= link_to t('.cta_primary'), new_user_registration_path,
          class: "btn btn-primary", aria: { describedby: "lp-closing-cta-note" } %>
  </div>

  <p id="lp-closing-cta-note" class="lp-cta-note"><%= t('.cta_note') %></p>
</section>
