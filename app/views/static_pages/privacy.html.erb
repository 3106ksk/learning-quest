<% content_for(:title, t('.title')) %>

<div class="page">
  <article class="form-shell">
    <h1><%= t('.title') %></h1>
    <p class="small"><%= t('.updated_at') %></p>
    <p style="margin-top: var(--space-5)"><%= t('.intro') %></p>

    <% t('.sections').each do |section| %>
      <section style="margin-top: var(--space-6)">
        <h2 class="legal-heading"><%= section[:heading] %></h2>
        <% section[:body]&.each do |paragraph| %>
          <p style="margin-top: var(--space-3)"><%= paragraph %></p>
        <% end %>
        <% if section[:items] %>
          <ul class="legal-list" style="margin-top: var(--space-3)">
            <% section[:items].each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
        <% end %>
      </section>
    <% end %>
  </article>
</div>
