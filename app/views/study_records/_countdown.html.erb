<%= turbo_frame_tag "countdown-#{study_record.id}" do %>
  <% if study_record.running? %>
    <p class="timer-status"></p>
    <p class="timer-display"
       data-controller="timer"
       data-timer-target="remaining"
       data-timer-expires-at-value="<%= study_record.expires_at.to_i %>"></p>

    <div class="timer-actions">
      <%= button_to "一時停止",
            pause_study_record_path(study_record),
            method: :patch,
            class: "btn btn-secondary" %>
    </div>
  <% elsif study_record.paused? %>
    <p class="timer-status">一時停止中</p>
    <p class="timer-display"><%= format_countdown(study_record.frozen_remaining_seconds) %></p>

    <div class="timer-actions">
      <%= button_to "再開",
            resume_study_record_path(study_record),
            method: :patch,
            class: "btn btn-secondary" %>
    </div>
  <% end %>
<% end %>
