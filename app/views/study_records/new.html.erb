<%= turbo_frame_tag "study-form" do %>
  <div class="page-wide">
    <div class="study-start-layout<%= ' has-goal' if @current_goal %>">
      <% if @current_goal %>
        <aside class="study-start-aside" aria-label="現在の目標">
          <section class="goal-card study-start-goal-card">
            <div class="grid-card-face face-active">
              <svg class="goal-card-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 21 10.5 3" />
                <path d="M10.5 4c3.3.3 5.5 3 8.5 3.5l-2.7 8.3c-3-.3-5.2-3-8.5-3.5z" />
              </svg>
              <span class="card-badge badge-active"><%= t("enums.goal.status.active") %></span>
            </div>
            <p class="goal-card-title"><%= @current_goal.name %></p>
          </section>
          <%= link_to "目標を見る →", goal_path(@current_goal), class: "study-start-goal-link", data: { turbo_frame: "_top" } %>
        </aside>
      <% end %>

      <div class="study-start-form">
      <h1>学習を始める</h1>

      <%= form_with model: @study_record, url: study_records_path,  data: { turbo_frame: "_top"}, class: "section form-stack", style: "margin-top: var(--space-5)" do |form| %>
        <% if @study_record.errors[:user_id].any? %>
          <p class="group-error" role="alert">
            すでに学習中の記録があります
          </p>
        <% end %>

        <fieldset>
          <legend class="field-label">時間を選ぶ</legend>
          <% if @study_record.errors[:planned_minutes].any? %>
            <p class="group-error">
              <%= @study_record.errors.full_messages_for(:planned_minutes).first %>
            </p>
          <% end %>

          <div class="segments">
            <% StudyRecord::ALLOWED_PLANNED_MINUTES.each do |minutes| %>
              <%= form.radio_button :planned_minutes, minutes, class: "segment-input" %>
              <%= form.label :planned_minutes, value: minutes, class: "segment-label" do %>
                <span class="num"><%= minutes %></span>分
              <% end %>
            <% end %>
          </div>
        </fieldset>

        <div>
          <%= form.label :activity, class: "field-label" %>
          <%= form.text_field :activity,
                maxlength: 100,
                placeholder: "例: 英単語を10個復習",
                class: "field-control#{' has-error' if @study_record.errors[:activity].any?}" %>
          <% if @study_record.errors[:activity].any? %>
            <p class="group-error">
              <%= @study_record.errors.full_messages_for(:activity).first %>
            </p>
          <% end %>
        </div>

        <%= form.submit "学習を開始する",
              data: { turbo_submits_with: "学習を開始します..." },
              class: "btn btn-primary disabled:cursor-not-allowed disabled:opacity-60" %>
      <% end %>
      </div>
    </div>
  </div>
<% end %>
