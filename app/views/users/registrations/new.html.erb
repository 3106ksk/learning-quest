<main class="public-page">
  <div class="form-shell">
    <section class="auth-form-card" aria-labelledby="registration-title">
      <div class="auth-form-eyebrow">
        <%= render "shared/auth_illustration", name: "flask" %>
        <p class="auth-form-eyebrow-text"><%= t(".eyebrow") %></p>
      </div>
      <h1 id="registration-title" class="auth-form-title"><%= t(".title") %></h1>

      <%= form_for(resource,
                   as: resource_name,
                   url: registration_path(resource_name),
                   html: { class: "section form-stack" }) do |f| %>
        <%= render "users/shared/error_messages", resource: resource %>

        <% account_name_has_error = f.object.errors[:account_name].any? %>
        <div>
          <div class="auth-field-head">
            <%= f.label :account_name, class: "auth-field-label" do %>
              <%= render "shared/auth_icon", name: "person" %>
              <%= User.human_attribute_name(:account_name) %>
            <% end %>
            <span class="auth-field-aux"><%= t(".account_name_aux") %></span>
          </div>
          <%= f.text_field :account_name,
                           autofocus: true,
                           autocomplete: "username",
                           class: "field-control#{' has-error' if account_name_has_error}",
                           aria: (account_name_has_error ? {
                             invalid: true,
                             describedby: "account_name-error"
                           } : {}) %>
          <% if account_name_has_error %>
            <p class="group-error" id="account_name-error">
              <%= f.object.errors.full_messages_for(:account_name).first %>
            </p>
          <% end %>
        </div>

        <% email_has_error = f.object.errors[:email].any? %>
        <div>
          <div class="auth-field-head">
            <%= f.label :email, class: "auth-field-label" do %>
              <%= render "shared/auth_icon", name: "mail" %>
              <%= User.human_attribute_name(:email) %>
            <% end %>
          </div>
          <%= f.email_field :email,
                            autocomplete: "email",
                            class: "field-control#{' has-error' if email_has_error}",
                            aria: (email_has_error ? {
                              invalid: true,
                              describedby: "email-error"
                            } : {}) %>
          <% if email_has_error %>
            <p class="group-error" id="email-error">
              <%= f.object.errors.full_messages_for(:email).first %>
            </p>
          <% end %>
        </div>

        <% password_has_error = f.object.errors[:password].any? %>
        <div>
          <div class="auth-field-head">
            <%= f.label :password, class: "auth-field-label" do %>
              <%= render "shared/auth_icon", name: "lock" %>
              <%= User.human_attribute_name(:password) %>
            <% end %>
            <% if @minimum_password_length %>
              <span class="auth-field-aux"><%= t(".password_aux", count: @minimum_password_length) %></span>
            <% end %>
          </div>
          <%= f.password_field :password,
                               autocomplete: "new-password",
                               class: "field-control#{' has-error' if password_has_error}",
                               aria: (password_has_error ? {
                                 invalid: true,
                                 describedby: "password-error"
                               } : {}) %>
          <% if password_has_error %>
            <p class="group-error" id="password-error">
              <%= f.object.errors.full_messages_for(:password).first %>
            </p>
          <% end %>
        </div>

        <% password_confirmation_has_error = f.object.errors[:password_confirmation].any? %>
        <div>
          <div class="auth-field-head">
            <%= f.label :password_confirmation, class: "auth-field-label" do %>
              <%= render "shared/auth_icon", name: "lock_check" %>
              <%= User.human_attribute_name(:password_confirmation) %>
            <% end %>
          </div>
          <%= f.password_field :password_confirmation,
                               autocomplete: "new-password",
                               class: "field-control#{' has-error' if password_confirmation_has_error}",
                               aria: (password_confirmation_has_error ? {
                                 invalid: true,
                                 describedby: "password_confirmation-error"
                               } : {}) %>
          <% if password_confirmation_has_error %>
            <p class="group-error" id="password_confirmation-error">
              <%= f.object.errors.full_messages_for(:password_confirmation).first %>
            </p>
          <% end %>
        </div>

        <%= f.submit t(".submit"), class: "btn btn-primary" %>

        <p class="small">
          <%= t(".consent_html",
                terms: link_to(t("shared.footer.terms"), terms_path),
                privacy: link_to(t("shared.footer.privacy"), privacy_path)) %>
        </p>
      <% end %>

      <div class="auth-form-links">
        <p class="small">
          <%= t(".to_login_notice") %>
          <%= link_to t(".to_login"), new_user_session_path %>
        </p>
      </div>
    </section>
  </div>
</main>
