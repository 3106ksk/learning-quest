<main class="public-page">
  <div class="form-shell">
    <section class="auth-form-card" aria-labelledby="registration-title">
      <h1 id="registration-title" class="auth-form-title"><%= t(".title") %></h1>

      <%= form_for(resource,
                   as: resource_name,
                   url: registration_path(resource_name),
                   html: { class: "section form-stack" }) do |f| %>
        <%= render "users/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :account_name, class: "field-label" %>
          <%= f.text_field :account_name,
                           autofocus: true,
                           autocomplete: "username",
                           class: "field-control" %>
        </div>

        <div>
          <%= f.label :email, class: "field-label" %>
          <%= f.email_field :email,
                            autocomplete: "email",
                            class: "field-control" %>
        </div>

        <div>
          <%= f.label :password, class: "field-label" %>
          <% if @minimum_password_length %>
            <p class="form-help"><%= t(".password_hint", count: @minimum_password_length) %></p>
          <% end %>
          <%= f.password_field :password,
                               autocomplete: "new-password",
                               class: "field-control" %>
        </div>

        <div>
          <%= f.label :password_confirmation, class: "field-label" %>
          <%= f.password_field :password_confirmation,
                               autocomplete: "new-password",
                               class: "field-control" %>
        </div>

        <%= f.submit t(".submit"), class: "btn btn-primary" %>
      <% end %>

      <div class="auth-form-links">
        <p class="small">
          <%= t(".to_login_notice") %>
          <%= link_to t(".to_login"), new_user_session_path %>
        </p>
      </div>
    </section>
  </div>
</main>
