<% content_for :title, t(".title") %>

<div class="page-wide">
  <div class="week-form">
    <h1 class="sr-only"><%= t(".heading") %></h1>
    <%= render "weekly_reflections/flow", current: 1 %>

    <%= form_with model: [ @goal, @weekly_reflection ], class: "form-stack" do |form| %>
      <section class="goal-card"
        <% if @weekly_reflection.errors[:learning_skill].any? || @weekly_reflection.errors[:learning_skill_id].any? %>
          style="border-color: var(--color-error-600)"
        <% end %>
      >
        <fieldset class="m-0 min-w-0 border-0 p-0"
          <% if @weekly_reflection.errors[:learning_skill].any? || @weekly_reflection.errors[:learning_skill_id].any? %>
            aria-describedby="weekly-reflection-skill-error" aria-invalid="true"
          <% end %>
        >
          <legend class="week-panel-head">
            <h2 class="week-panel-title"><%= t(".skill_question") %></h2>
            <% if @skill_settings.any? %>
              <span class="week-panel-count"><%= t(".choose_one", count: @skill_settings.size) %></span>
            <% end %>
          </legend>
          <% if @weekly_reflection.errors[:learning_skill].any? || @weekly_reflection.errors[:learning_skill_id].any? %>
            <p class="group-error" id="weekly-reflection-skill-error" role="alert">
              <%= (@weekly_reflection.errors.full_messages_for(:learning_skill) + @weekly_reflection.errors.full_messages_for(:learning_skill_id)).first %>
            </p>
          <% end %>

          <div class="skill-cards">
            <% if @skill_settings.empty? %>
              <span class="skill-card-slot is-empty"><%= t(".skills_empty") %></span>
            <% end %>
            <% @skill_settings.each do |setting| %>
              <%= form.radio_button :learning_skill_id, setting.learning_skill_id, class: "skill-card-input" %>
              <%= form.label :learning_skill_id, value: setting.learning_skill_id, class: "skill-card week-skill-card" do %>
                <span class="skill-card-face"><%= render "shared/bulb_icon", css_class: "skill-card-bulb" %></span>
                <span class="skill-card-name"><%= setting.learning_skill.name %></span>
                <span class="week-radio" aria-hidden="true"></span>
              <% end %>
            <% end %>
          </div>
          <% if @skill_settings.empty? %>
            <div style="text-align: right">
              <%= link_to t(".skill_settings_link"), goal_skill_settings_path(@goal), class: "skill-select-link" %>
            </div>
          <% end %>
        </fieldset>
      </section>

      <section class="goal-card"
        <% if @weekly_reflection.errors[:expectation].any? %>
          style="border-color: var(--color-error-600)"
        <% end %>
      >
        <fieldset class="m-0 min-w-0 border-0 p-0"
          <% if @weekly_reflection.errors[:expectation].any? %>
            aria-describedby="weekly-reflection-expectation-error" aria-invalid="true"
          <% end %>
        >
          <legend class="week-panel-head">
            <h2 class="week-panel-title"><%= t(".expectation_question") %></h2>
            <span class="week-panel-count"><%= t(".choose_one", count: WeeklyReflection.expectations.size) %></span>
          </legend>
          <% if @weekly_reflection.errors[:expectation].any? %>
            <p class="group-error" id="weekly-reflection-expectation-error" role="alert">
              <%= @weekly_reflection.errors.full_messages_for(:expectation).first %>
            </p>
          <% end %>

          <div class="week-choices<%= ' has-error' if @weekly_reflection.errors[:expectation].any? %>">
            <% WeeklyReflection.expectations.keys.each do |value| %>
              <%= form.radio_button :expectation, value, class: "week-choice-input" %>
              <%= form.label :expectation, value: value, class: "week-choice" do %>
                <%= t("enums.weekly_reflection.expectation.#{value}") %>
                <span class="week-radio" aria-hidden="true"></span>
              <% end %>
            <% end %>
          </div>
        </fieldset>

        <div class="week-note">
          <div class="week-note-head">
            <%= form.label :expectation_note, t(".note_label"), class: "field-label" %>
            <span class="week-note-hint" id="expectation-note-help"><%= t(".note_help") %></span>
          </div>
          <%= form.text_area :expectation_note,
                rows: 4,
                maxlength: 200,
                placeholder: t(".note_placeholder"),
                class: "field-control#{' has-error' if @weekly_reflection.errors[:expectation_note].any?}",
                aria: {
                  describedby: [ "expectation-note-help", ("weekly-reflection-note-error" if @weekly_reflection.errors[:expectation_note].any?) ].compact.join(" "),
                  invalid: ("true" if @weekly_reflection.errors[:expectation_note].any?)
                } %>
          <% if @weekly_reflection.errors[:expectation_note].any? %>
            <p class="group-error" id="weekly-reflection-note-error" role="alert">
              <%= @weekly_reflection.errors.full_messages_for(:expectation_note).first %>
            </p>
          <% end %>
        </div>
      </section>

      <div class="button-row" style="justify-content: center">
        <%= form.submit t(".submit"),
              disabled: @skill_settings.empty?,
              class: "btn btn-primary week-submit disabled:cursor-not-allowed disabled:opacity-60" %>
      </div>
    <% end %>
  </div>
</div>
