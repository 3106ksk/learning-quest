<% content_for :title, t(".title") %>

<div class="page-wide">
  <section class="goal-card" aria-labelledby="weekly-reflection-title">
    <header>
      <p class="skill-select-eyebrow">
        <%= weekly_reflection_period(@weekly_reflection.week_start_on) %><%= t(".week_suffix") %>
      </p>
      <h1 id="weekly-reflection-title" class="goal-card-title" style="margin-top: var(--space-3); overflow-wrap: anywhere"><%= @goal.name %></h1>
    </header>

    <dl class="definition-list" style="margin-top: var(--space-5)">
      <div class="definition-row">
        <dt><%= t(".skill_label") %></dt>
        <dd><%= @weekly_reflection.learning_skill.name %></dd>
      </div>
      <div class="definition-row">
        <dt><%= t(".expectation_label") %></dt>
        <dd>
          <%= t("enums.weekly_reflection.expectation.#{@weekly_reflection.expectation}") %>
          <% if @weekly_reflection.expectation_note.present? %>
            <p class="form-help" style="white-space: pre-wrap"><%= t(".note_label") %>：<%= @weekly_reflection.expectation_note %></p>
          <% end %>
        </dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="weekly-study-title" style="margin-top: var(--space-5)">
    <h2 id="weekly-study-title" class="section-title"><%= t(".study_heading") %></h2>

    <dl class="definition-list">
      <div class="definition-row">
        <dt></dt>
        <dd style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)">
          <div>
            <p class="small"><%= t(".previous_week") %></p>
            <% if @weekly_study[:previous_week_exists] %>
              <p><%= weekly_reflection_period(@weekly_reflection.week_start_on.prev_week) %></p>
            <% else %>
              <p><%= t(".no_previous_week") %></p>
            <% end %>
          </div>
          <div>
            <p class="small">
              <% if @weekly_study[:week_finished] %>
                <%= t(".current_week") %>
              <% else %>
                <%= t(".current_week_in_progress") %>
              <% end %>
            </p>
            <p><%= weekly_reflection_period(@weekly_reflection.week_start_on) %></p>
          </div>
        </dd>
      </div>
      <div class="definition-row">
        <dt><%= t(".study_count_label") %></dt>
        <dd style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)">
          <span class="num">
            <% if @weekly_study[:previous_week_exists] %>
              <%= t(".times", count: @weekly_study[:previous][:study_count]) %>
            <% end %>
          </span>
          <span class="num"><%= t(".times", count: @weekly_study[:current][:study_count]) %></span>
        </dd>
      </div>
      <div class="definition-row">
        <dt><%= t(".study_days_label") %></dt>
        <dd style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)">
          <span class="num">
            <% if @weekly_study[:previous_week_exists] %>
              <%= t(".days", count: @weekly_study[:previous][:study_days]) %>
            <% end %>
          </span>
          <span class="num"><%= t(".days", count: @weekly_study[:current][:study_days]) %></span>
        </dd>
      </div>
      <div class="definition-row">
        <dt><%= t(".selected_count_label") %></dt>
        <dd style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)">
          <span class="num">
            <% if @weekly_study[:previous_week_exists] %>
              <%= t(".times", count: @weekly_study[:previous][:selected_count]) %>
            <% end %>
          </span>
          <span class="num"><%= t(".times", count: @weekly_study[:current][:selected_count]) %></span>
        </dd>
      </div>
    </dl>

    <p class="caption" style="margin-top: var(--space-3)"><%= t(".study_note") %></p>
  </section>
</div>
