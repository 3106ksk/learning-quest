<% content_for :title, t(".title") %>

<div class="page-wide">
  <section class="goal-card" aria-labelledby="weekly-reflection-title">
    <header>
      <p class="skill-select-eyebrow">
        <%= weekly_reflection_period(@weekly_reflection.week_start_on) %><%= t(".week_suffix") %>
      </p>
      <h1 id="weekly-reflection-title" class="goal-card-title" style="margin-top: var(--space-3); overflow-wrap: anywhere"><%= @goal.name %></h1>
    </header>

    <dl class="definition-list" style="margin-top: var(--space-5)">
      <div class="definition-row">
        <dt><%= t(".skill_label") %></dt>
        <dd><%= @weekly_reflection.learning_skill.name %></dd>
      </div>
      <div class="definition-row">
        <dt><%= t(".expectation_label") %></dt>
        <dd>
          <%= t("enums.weekly_reflection.expectation.#{@weekly_reflection.expectation}") %>
          <% if @weekly_reflection.expectation_note.present? %>
            <p class="form-help" style="white-space: pre-wrap"><%= t(".note_label") %>：<%= @weekly_reflection.expectation_note %></p>
          <% end %>
        </dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="weekly-study-title" style="margin-top: var(--space-5)">
    <h2 id="weekly-study-title" class="section-title"><%= t(".study_heading") %></h2>

    <dl class="definition-list">
      <div class="definition-row">
        <dt></dt>
        <dd style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)">
          <div>
            <p class="small"><%= t(".previous_week") %></p>
            <% if @weekly_study[:previous_week_exists] %>
              <p><%= weekly_reflection_period(@weekly_reflection.week_start_on.prev_week) %></p>
            <% else %>
              <p><%= t(".no_previous_week") %></p>
            <% end %>
          </div>
          <div>
            <p class="small"><%= t(".current_week") %></p>
            <p><%= weekly_reflection_period(@weekly_reflection.week_start_on) %></p>
          </div>
        </dd>
      </div>
      <div class="definition-row">
        <dt><%= t(".study_count_label") %></dt>
        <dd style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)">
          <span class="num">
            <% if @weekly_study[:previous_week_exists] %>
              <%= t(".times", count: @weekly_study[:previous][:study_count]) %>
            <% end %>
          </span>
          <span class="num"><%= t(".times", count: @weekly_study[:current][:study_count]) %></span>
        </dd>
      </div>
      <div class="definition-row">
        <dt><%= t(".study_days_label") %></dt>
        <dd style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)">
          <span class="num">
            <% if @weekly_study[:previous_week_exists] %>
              <%= t(".days", count: @weekly_study[:previous][:study_days]) %>
            <% end %>
          </span>
          <span class="num"><%= t(".days", count: @weekly_study[:current][:study_days]) %></span>
        </dd>
      </div>
      <div class="definition-row">
        <dt><%= t(".selected_count_label") %></dt>
        <dd style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)">
          <span class="num">
            <% if @weekly_study[:previous_week_exists] %>
              <%= t(".times", count: @weekly_study[:previous][:selected_count]) %>
            <% end %>
          </span>
          <span class="num"><%= t(".times", count: @weekly_study[:current][:selected_count]) %></span>
        </dd>
      </div>
    </dl>

    <h3 style="margin-top: var(--space-5)"><%= t(".breakdown_heading", skill: @weekly_reflection.learning_skill.name) %></h3>

    <h4 class="small" style="margin-top: var(--space-3)"><%= t(".focus_heading") %></h4>
    <dl class="definition-list">
      <% @weekly_study[:current][:focus].each do |option, count| %>
        <div class="definition-row">
          <dt><%= option.label %></dt>
          <dd style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)">
            <span class="num">
              <% if @weekly_study[:previous_week_exists] %>
                <%= t(".times", count: @weekly_study[:previous][:focus][option]) %>
              <% end %>
            </span>
            <span class="num"><%= t(".times", count: count) %></span>
          </dd>
        </div>
      <% end %>
    </dl>

    <h4 class="small" style="margin-top: var(--space-3)"><%= t(".challenge_heading") %></h4>
    <dl class="definition-list">
      <% @weekly_study[:current][:challenge].each do |option, count| %>
        <div class="definition-row">
          <dt><%= option.label %></dt>
          <dd style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)">
            <span class="num">
              <% if @weekly_study[:previous_week_exists] %>
                <%= t(".times", count: @weekly_study[:previous][:challenge][option]) %>
              <% end %>
            </span>
            <span class="num"><%= t(".times", count: count) %></span>
          </dd>
        </div>
      <% end %>
    </dl>
  </section>

  <% if @goal.active? %>
    <%= form_with model: @weekly_reflection,
          url: goal_weekly_reflection_review_path(@goal, @weekly_reflection),
          method: :patch,
          class: "form-stack",
          style: "margin-top: var(--space-5)" do |form| %>
      <section class="goal-card">
        <fieldset class="m-0 min-w-0 border-0 p-0"
          <% if @weekly_reflection.errors[:feeling].any? %>
            aria-describedby="weekly-reflection-feeling-error" aria-invalid="true"
          <% end %>
        >
          <legend class="skill-select-legend">
            <span class="skill-select-eyebrow" aria-hidden="true">1</span>
            <h2>
              <% if @weekly_reflection.expectation_undecided? %>
                <%= t(".feeling_question_undecided", skill: @weekly_reflection.learning_skill.name) %>
              <% else %>
                <%= t(".feeling_question", expectation: t("enums.weekly_reflection.expectation.#{@weekly_reflection.expectation}")) %>
              <% end %>
            </h2>
          </legend>
          <% if @weekly_reflection.errors[:feeling].any? %>
            <p class="group-error" id="weekly-reflection-feeling-error" role="alert">
              <%= @weekly_reflection.errors.full_messages_for(:feeling).first %>
            </p>
          <% end %>

          <div class="choice-list<%= ' has-error' if @weekly_reflection.errors[:feeling].any? %>">
            <% WeeklyReflection.feelings.keys.each do |value| %>
              <%= form.radio_button :feeling, value, class: "choice-input" %>
              <%= form.label :feeling, value: value, class: "choice-row" do %>
                <span class="choice-mark" aria-hidden="true"></span>
                <span><%= t("enums.weekly_reflection.feeling.#{value}") %></span>
              <% end %>
            <% end %>
          </div>
        </fieldset>
      </section>

      <section class="goal-card">
        <div class="skill-select-legend">
          <span class="skill-select-eyebrow" aria-hidden="true">2</span>
          <%= form.label :comment, t(".comment_heading"), class: "field-label" %>
        </div>
        <p class="small" id="comment-help" style="margin-bottom: var(--space-2)"><%= t(".comment_help") %></p>
        <%= form.text_area :comment,
              rows: 4,
              maxlength: 200,
              class: "field-control#{' has-error' if @weekly_reflection.errors[:comment].any?}",
              aria: {
                describedby: [ "comment-help", ("weekly-reflection-comment-error" if @weekly_reflection.errors[:comment].any?) ].compact.join(" "),
                invalid: ("true" if @weekly_reflection.errors[:comment].any?)
              } %>
        <% if @weekly_reflection.errors[:comment].any? %>
          <p class="group-error" id="weekly-reflection-comment-error" role="alert">
            <%= @weekly_reflection.errors.full_messages_for(:comment).first %>
          </p>
        <% end %>
      </section>

      <div class="button-row" style="justify-content: center">
        <%= form.submit t(".submit"), class: "btn btn-primary" %>
      </div>
    <% end %>
  <% elsif @weekly_reflection.reflected_at.present? %>
    <section aria-labelledby="weekly-review-title" style="margin-top: var(--space-5)">
      <h2 id="weekly-review-title" class="section-title"><%= t(".review_heading") %></h2>

      <dl class="definition-list">
        <div class="definition-row">
          <dt><%= t(".feeling_label") %></dt>
          <dd><%= t("enums.weekly_reflection.feeling.#{@weekly_reflection.feeling}") %></dd>
        </div>
        <% if @weekly_reflection.comment.present? %>
          <div class="definition-row">
            <dt><%= t(".comment_label") %></dt>
            <dd style="white-space: pre-wrap; overflow-wrap: anywhere"><%= @weekly_reflection.comment %></dd>
          </div>
        <% end %>
      </dl>
    </section>
  <% end %>
</div>
